# ---------------------------------------------------------------------------
# Fentra configuration. Copy to .env.local. Never commit real keys.
# ---------------------------------------------------------------------------

# AI agent (optional). Without it Fentra falls back to a deterministic
# proposer, and the risk-control demo still runs end to end.
ANTHROPIC_API_KEY=

# Model override. Defaults to claude-haiku-4-5, the cheapest current model,
# which is ample for reading tools and forming a proposal.
# FENTRA_MODEL=claude-sonnet-5

# Binance execution (optional). Leave both blank to stay in Demo Mode:
# live public market data, locally simulated fills, nothing sent to Binance.
# Set both to trade USDs-M futures through the documented signed REST API.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet by default. Set to false ONLY to trade real funds.
BINANCE_TESTNET=true

# Optional override for the USDs-M futures host. Leave unset to use the
# documented defaults: demo-fapi.binance.com (testnet) / fapi.binance.com (live).
# Set this if your network cannot resolve the default host. The previous
# testnet host still answers and is a working alternative:
# BINANCE_FUTURES_BASE=https://testnet.binancefuture.com

# Optional override for the public market-data host. Defaults to
# api.binance.com. Binance serves the same unauthenticated /api/v3 endpoints
# from data-api.binance.vision, which some networks can reach when
# api.binance.com is blocked. Fentra refuses to place a live order without a
# live quote, so if this host is unreachable, trading stops:
# BINANCE_PUBLIC_BASE=https://data-api.binance.vision

# ---------------------------------------------------------------------------
# x402 paid risk API — POST /api/risk/check
#
# The endpoint ALWAYS requires an x402 payment header; there is no free tier.
# What these variables change is whether the payment is really verified.
#
#   DEMO MODE (default) — no facilitator configured. A well-formed payment
#     header is accepted and then reported as "simulated". Nothing is verified
#     on-chain, no USDC moves, and payTo is advertised as the zero address.
#
#   LIVE MODE — set BOTH the facilitator URL and the receiving address. The
#     payment is verified through the facilitator's /verify endpoint before the
#     risk engine runs.
#
# These are separate from Fentra's Binance trading credentials on purpose: the
# payment path and the execution path must share no credential. Use a dedicated
# receiving address, never a trading or execution wallet. Never put a private
# key in this file — Fentra only ever needs the public receiving address.
# ---------------------------------------------------------------------------

# Wire generation. 2 (default) = BNB Chain rails: eip155:56, permit2-exact,
# 18-decimal Binance-Peg USDC. 1 = Base Sepolia rails: base-sepolia, exact,
# 6-decimal USDC — the combination public facilitators actually settle today.
# Changing this switches network, scheme, asset and decimals together; each is
# still individually overridable below.
# FENTRA_X402_PROTOCOL_VERSION=1

# Base URL of a spec-compliant x402 facilitator, without a trailing slash.
# Fentra POSTs to {URL}/verify. Leave unset for DEMO MODE.
# Verified working: https://x402.org/facilitator (Base Sepolia, no key).
# FENTRA_X402_FACILITATOR_URL=

# Optional bearer token for the facilitator. Server-side only; it is never
# included in any API response.
# FENTRA_X402_FACILITATOR_API_KEY=

# Dedicated merchant receiving address (public address only).
# FENTRA_X402_PAY_TO=

# Price per risk check. One fixed price; there are no tiers.
# FENTRA_X402_PRICE_USDC=0.01

# Payment rails. Defaults are BNB Chain mainnet and Binance-Peg USDC, which is
# 18-decimal on BSC. Confirm against the facilitator's /supported list before
# pointing this at real money.
#
# Stablecoins seen in live Binance B402 listings, all 18-decimal on BSC:
#   USDC  0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d   (default)
#   USDT  0x55d398326f99059fF775485246999027B3197955
#   USD1  0x8d0D000Ee44948FC98c9B98A4FA4921476f08B0d
#   U     0xcE24439F2D9C6a2289F741120FE202248B666666
# Schemes seen in production: permit2-exact (default) and eip3009.
# FENTRA_X402_NETWORK=eip155:56
# FENTRA_X402_SCHEME=permit2-exact
# FENTRA_X402_ASSET=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
# FENTRA_X402_ASSET_DECIMALS=18
# FENTRA_X402_ASSET_SYMBOL=USDC
# FENTRA_X402_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Paying client only — scripts/x402-pay.mjs. NOT read by the server.
#
# A THROWAWAY testnet key. Never a mainnet key, and never a key that holds
# anything you would mind losing. Fund the wallet with Base Sepolia USDC from
# https://faucet.circle.com — no ETH needed, the facilitator pays gas.
# ---------------------------------------------------------------------------
# X402_PAYER_PRIVATE_KEY=
