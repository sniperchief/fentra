# ---------------------------------------------------------------------------
# Fentra configuration. Copy to .env.local. Never commit real keys.
# ---------------------------------------------------------------------------

# AI agent (optional). Without it Fentra falls back to a deterministic
# proposer, and the risk-control demo still runs end to end.
ANTHROPIC_API_KEY=

# Model override. Defaults to claude-haiku-4-5, the cheapest current model,
# which is ample for reading tools and forming a proposal.
# FENTRA_MODEL=claude-sonnet-5

# Binance execution (optional). Leave both blank to stay in Demo Mode:
# live public market data, locally simulated fills, nothing sent to Binance.
# Set both to trade USDs-M futures through the documented signed REST API.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet by default. Set to false ONLY to trade real funds.
BINANCE_TESTNET=true

# Optional override for the USDs-M futures host. Leave unset to use the
# documented defaults: demo-fapi.binance.com (testnet) / fapi.binance.com (live).
# BINANCE_FUTURES_BASE=

# x402 stretch feature for POST /api/risk/check. Leave unset to keep the
# endpoint open. Setting a price gates the endpoint with HTTP 402; payment
# settlement requires a facilitator, which is not wired up.
# FENTRA_X402_PRICE_USDC=0.01
# FENTRA_X402_NETWORK=base-sepolia
# FENTRA_X402_PAY_TO=
